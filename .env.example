# ==============================================================================
# Vishwas AI - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real API keys.
# ==============================================================================

# LLM Provider: "groq", "openai", or "anthropic"
LLM_PROVIDER=groq

# Model Name matching your provider:
# - Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b, llama-3.3-70b-versatile, etc.
# - OpenAI: gpt-4o, gpt-4o-mini, etc.
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, etc.
LLM_MODEL=openai/gpt-oss-120b

# LLM Provider API Key
LLM_API_KEY=your_llm_api_key_here

# Tavily Search API Key
SEARCH_API_KEY=your_tavily_api_key_here
